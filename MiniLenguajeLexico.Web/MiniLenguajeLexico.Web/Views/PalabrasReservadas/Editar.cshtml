@model MiniLenguajeLexico.Web.Models.EditarPalabraReservadaViewModel
@{
    ViewData["Title"] = "Editar palabra reservada";
}

<section class="reserved-shell">
    <div class="analyzer-hero">
        <div>
            <h1>Editar palabra reservada</h1>
            <p class="hero-copy">
                Modifica la palabra seleccionada y decide si debe permanecer activa para futuros analisis.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-card-header">
                    <div>
                        <h2>Datos de la palabra</h2>
                        <p>Actualiza su valor o estado y guarda los cambios.</p>
                    </div>
                </div>

                <form asp-controller="PalabrasReservadas" asp-action="Editar" asp-route-id="@Model.IdPalabraReservada" method="post" novalidate>
                    <input asp-for="IdPalabraReservada" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Palabra" class="form-label"></label>
                        <input asp-for="Palabra" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Palabra" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch my-3">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary analyze-button">Guardar cambios</button>
                        <a asp-controller="PalabrasReservadas" asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
                {
                    <div class="alert alert-success mt-3 mb-0" role="alert">
                        @Model.MensajeExito
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        @Model.MensajeError
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
