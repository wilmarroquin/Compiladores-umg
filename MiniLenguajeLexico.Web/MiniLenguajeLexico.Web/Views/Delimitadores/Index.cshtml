@model MiniLenguajeLexico.Web.Models.DelimitadoresViewModel
@{
    ViewData["Title"] = "Delimitadores";
}

<section class="reserved-shell">
    <div class="analyzer-hero">
        <div>
            <h1>Delimitadores</h1>
            <p class="hero-copy">
                Registra nuevos simbolos y administra los existentes para que el analizador los trate como delimitadores.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="panel-card">
                <div class="panel-card-header">
                    <div>
                        <h2>Nuevo delimitador</h2>
                        <p>Ingresa un solo simbolo. El sistema conserva los delimitadores base y suma los nuevos.</p>
                    </div>
                </div>

                <form asp-controller="Delimitadores" asp-action="Index" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NuevoDelimitador" class="form-label"></label>
                        <input asp-for="NuevoDelimitador" class="form-control" autocomplete="off" maxlength="1" placeholder="Ejemplo: #" />
                        <span asp-validation-for="NuevoDelimitador" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary analyze-button">Agregar delimitador</button>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
                {
                    <div class="alert alert-success mt-3 mb-0" role="alert">
                        @Model.MensajeExito
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">
                        @Model.MensajeError
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7">
            <div class="panel-card">
                <div class="panel-card-header">
                    <div>
                        <h2>Listado actual</h2>
                        <p>@Model.Delimitadores.Count delimitador(es) registrado(s) para el analizador.</p>
                    </div>
                </div>

                @if (Model.Delimitadores.Count == 0)
                {
                    <div class="empty-state">
                        <h3>No hay delimitadores registrados</h3>
                        <p>Agrega un delimitador nuevo para verlo listado aqui.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle result-table">
                            <thead>
                                <tr>
                                    <th>Simbolo</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var delimitador in Model.Delimitadores)
                                {
                                    <tr>
                                        <td><code>@delimitador.Simbolo</code></td>
                                        <td>@(delimitador.Activo ? "Activo" : "Inactivo")</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2">
                                                <a asp-controller="Delimitadores" asp-action="Editar" asp-route-id="@delimitador.IdDelimitador" class="btn btn-outline-secondary btn-sm">Editar</a>
                                                <form asp-controller="Delimitadores" asp-action="Eliminar" asp-route-id="@delimitador.IdDelimitador" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('¿Deseas eliminar este delimitador?');">Eliminar</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
